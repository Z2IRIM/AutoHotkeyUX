<Page x:Class="AutoHotkeyUX.Modern.Pages.NewScriptPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageBody" Padding="28,28,28,40" Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock Text="VISUAL SCRIPT" Style="{StaticResource EyebrowTextStyle}" />
                <TextBlock x:Name="PageTitle" Text="Build a workflow" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Choose a trigger, add actions, then set their properties. Your workflow becomes an AutoHotkey v2 script." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="16">
                <Grid x:Name="DetailsGrid" ColumnSpacing="16" RowSpacing="12" SizeChanged="DetailsGrid_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBox x:Name="ScriptNameTextBox" Header="Name" Text="QuickActions" MaxLength="128" TextChanged="ScriptInput_Changed" />
                    <Grid x:Name="LocationPanel" Grid.Column="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="ScriptLocationTextBox" Header="Location" MaxLength="2048" TextChanged="ScriptInput_Changed" />
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse" VerticalAlignment="Bottom" Click="Browse_Click" />
                    </Grid>
                </Grid>
            </Border>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button Content="Examples" Click="Examples_Click" />
                <TextBlock Grid.Column="1" Text="Terminal / extract · Copy selected path · Launch and type" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <Grid x:Name="EditorGrid" ColumnSpacing="16" RowSpacing="16" SizeChanged="EditorGrid_SizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border x:Name="LibraryPanel" Style="{StaticResource SurfaceCardStyle}" Padding="12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Action library" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="Click to add a step" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel x:Name="ActionLibrary" Spacing="8" />
                    </StackPanel>
                </Border>
                <Border x:Name="FlowPanel" Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Your workflow" Style="{StaticResource SectionTitleTextStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ActionCountText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel x:Name="HistoryButtons" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button x:Name="UndoButton" Padding="8" ToolTipService.ToolTip="Undo" AutomationProperties.Name="Undo" Click="Undo_Click"><FontIcon Glyph="&#xE7A7;" FontSize="16" /></Button>
                                <Button x:Name="RedoButton" Padding="8" ToolTipService.ToolTip="Redo" AutomationProperties.Name="Redo" Click="Redo_Click"><FontIcon Glyph="&#xE7A6;" FontSize="16" /></Button>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="TriggerButton" Style="{StaticResource InteractiveCardButtonStyle}" Padding="12" HorizontalAlignment="Stretch" Click="Trigger_Click" AutomationProperties.Name="Edit workflow trigger">
                            <StackPanel Spacing="4">
                                <TextBlock Text="TRIGGER" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock x:Name="TriggerSummaryText" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="ScopeSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <ListView x:Name="ActionList" SelectionMode="Single" CanDragItems="True" CanReorderItems="True" AllowDrop="True" IsSwipeEnabled="False"
                            MaxHeight="440" SelectionChanged="ActionList_SelectionChanged" DragItemsStarting="ActionList_DragItemsStarting"
                            DragItemsCompleted="ActionList_DragItemsCompleted" AutomationProperties.Name="Ordered workflow actions">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,8" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SurfaceCardStyle}" CornerRadius="8" Margin="{Binding Indent}">
                                    <Grid Padding="12" ColumnSpacing="10" MinHeight="76">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Summary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="EmptyFlowText" Text="Add your first action from the library." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                        <StackPanel x:Name="OrderButtons" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="UpButton" Padding="10" ToolTipService.ToolTip="Move selected action up" AutomationProperties.Name="Move selected action up" Click="Up_Click"><FontIcon Glyph="&#xE74A;" FontSize="16" /></Button>
                            <Button x:Name="DownButton" Padding="10" ToolTipService.ToolTip="Move selected action down" AutomationProperties.Name="Move selected action down" Click="Down_Click"><FontIcon Glyph="&#xE74B;" FontSize="16" /></Button>
                            <Button x:Name="DeleteButton" Padding="10" ToolTipService.ToolTip="Delete selected action" AutomationProperties.Name="Delete selected action" Click="Delete_Click"><FontIcon Glyph="&#xE74D;" FontSize="16" /></Button>
                        </StackPanel>
                        <Button x:Name="RootInsertionButton" Content="Append after workflow" Click="RootInsertion_Click" />
                        <TextBlock x:Name="InsertionHintText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="OrderHintText" Text="Actions run from top to bottom. Drag to reorder, or use the arrow buttons." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border x:Name="PropertiesPanel" Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" Padding="16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Properties" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock x:Name="SelectedTitleText" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <StackPanel x:Name="TriggerFields" Spacing="12">
                            <ComboBox x:Name="TriggerKindCombo" Header="When to run" HorizontalAlignment="Stretch" SelectionChanged="TriggerInput_Changed">
                                <ComboBoxItem Content="Keyboard shortcut" /><ComboBoxItem Content="When script starts" />
                            </ComboBox>
                            <StackPanel x:Name="HotkeyFields" Spacing="8">
                                <TextBlock Text="Modifiers" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid ColumnSpacing="8" RowSpacing="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <CheckBox x:Name="CtrlCheck" Content="Ctrl" Click="Modifiers_Click" /><CheckBox x:Name="AltCheck" Grid.Column="1" Content="Alt" Click="Modifiers_Click" />
                                    <CheckBox x:Name="ShiftCheck" Grid.Row="1" Content="Shift" Click="Modifiers_Click" /><CheckBox x:Name="WinCheck" Grid.Row="1" Grid.Column="1" Content="Win" Click="Modifiers_Click" />
                                </Grid>
                                <ComboBox x:Name="TriggerKeyCombo" Header="Key" HorizontalAlignment="Stretch" SelectionChanged="TriggerInput_Changed" />
                            </StackPanel>
                            <ComboBox x:Name="ScopeCombo" Header="Active window" HorizontalAlignment="Stretch" SelectionChanged="Scope_Changed">
                                <ComboBoxItem Content="Any application" /><ComboBoxItem Content="Only this application" /><ComboBoxItem Content="File Explorer and desktop" />
                            </ComboBox>
                            <TextBox x:Name="ApplicationBox" Header="Application file name" PlaceholderText="explorer.exe" MaxLength="128" TextChanged="Application_Changed" />
                            <TextBlock Text="The application condition applies to the whole workflow. Creating a script does not start it." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="ActionFields" Spacing="12" Visibility="Collapsed">
                            <ComboBox x:Name="FolderCombo" Header="Folder" HorizontalAlignment="Stretch" SelectionChanged="Folder_Changed">
                                <ComboBoxItem Content="Documents" /><ComboBoxItem Content="Desktop" /><ComboBoxItem Content="Custom folder" />
                            </ComboBox>
                            <TextBox x:Name="ActionValueBox" Header="Value" MaxLength="4096" TextWrapping="Wrap" TextChanged="ActionValue_Changed" />
                            <ComboBox x:Name="SendKeysCombo" Header="Key combination" HorizontalAlignment="Stretch" SelectionChanged="SendKeys_Changed" />
                            <NumberBox x:Name="WaitBox" Header="Milliseconds" Minimum="0" Maximum="60000" SpinButtonPlacementMode="Compact" ValueChanged="Wait_Changed" />
                            <TextBlock x:Name="ParameterHintText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="ExtendedFields" Spacing="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock x:Name="FieldErrorsText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
            <TextBlock x:Name="ShortcutWarningText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
            <Expander x:Name="CodeExpander" Header="Generated AutoHotkey code" HorizontalAlignment="Stretch" IsExpanded="False">
                <TextBox x:Name="ScriptPreviewTextBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="13" MinHeight="160" MaxHeight="280"
                    TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Generated AutoHotkey source" />
            </Expander>
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="CreateScriptStatusText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="SaveButtons" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveButton" Content="Create script" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" /><Button x:Name="ScriptsButton" Content="Open Scripts" Click="Scripts_Click" />
                    </StackPanel>
                    <StackPanel x:Name="SavedActions" Spacing="8" Visibility="Collapsed">
                        <Button x:Name="CodeEditorButton" Content="Edit in code editor" Click="CodeEditor_Click" /><Button x:Name="NewWorkflowButton" Content="New workflow" Click="NewWorkflow_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <InfoBar x:Name="CreateInfoBar" IsOpen="False" IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
