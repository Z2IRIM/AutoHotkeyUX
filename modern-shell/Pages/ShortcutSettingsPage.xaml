<Page x:Class="AutoHotkeyUX.Modern.Pages.ShortcutSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1080" Padding="44,32,44,48" Spacing="22">
            <Button Content="←  Settings" Click="Back_Click" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Explorer shortcuts" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:Name="EngineStatusText" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <TextBlock Text="Quick actions in File Explorer and on the desktop." Style="{StaticResource PageSubtitleTextStyle}" />
            <SelectorBar x:Name="SettingsTabs" SelectionChanged="SettingsTabs_SelectionChanged">
                <SelectorBarItem x:Name="PreferencesTab" Text="Preferences" IsSelected="True" />
                <SelectorBarItem x:Name="ActivityTab" Text="Recent activity" />
            </SelectorBar>
            <InfoBar x:Name="PreferencesInfoBar" IsOpen="False" />
            <StackPanel x:Name="PreferencesPanel" Spacing="20">
                <TextBlock x:Name="ContextText" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel>
                        <Grid Padding="24,20" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="45" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE756;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /></Border>
                            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Open terminal" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock Text="Folders and empty file space" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                            <ToggleSwitch x:Name="TerminalEnabledToggle" Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="Enable terminal shortcut" Toggled="Draft_Toggled" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid x:Name="TerminalLayout" Padding="24" ColumnSpacing="24" RowSpacing="20" SizeChanged="TerminalLayout_SizeChanged">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel x:Name="TerminalFields" Spacing="18">
                                <ComboBox x:Name="TerminalKeyCombo" Header="Shortcut" HorizontalAlignment="Stretch" SelectionChanged="Draft_SelectionChanged">
                                    <ComboBoxItem Content="Alt + left click" Tag="alt-left" /><ComboBoxItem Content="Ctrl + Alt + left click" Tag="ctrl-alt-left" /><ComboBoxItem Content="Alt + middle click" Tag="alt-middle" /><ComboBoxItem Content="Ctrl + Alt + middle click" Tag="ctrl-alt-middle" /><ComboBoxItem Content="Ctrl + left click" Tag="ctrl-left" />
                                </ComboBox>
                                <ComboBox x:Name="ProgramCombo" Header="Terminal program" HorizontalAlignment="Stretch" SelectionChanged="Draft_SelectionChanged">
                                    <ComboBoxItem Content="Auto · prefer Windows Terminal" Tag="auto" /><ComboBoxItem Content="Windows Terminal" Tag="wt" /><ComboBoxItem Content="Windows PowerShell" Tag="powershell" />
                                </ComboBox>
                                <ComboBox x:Name="PositionCombo" Header="Open window" HorizontalAlignment="Stretch" SelectionChanged="Draft_SelectionChanged">
                                    <ComboBoxItem Content="Above the mouse pointer" Tag="above" /><ComboBoxItem Content="Centered on the screen" Tag="center" />
                                </ComboBox>
                                <Grid x:Name="DimensionsGrid" ColumnSpacing="10" RowSpacing="12" SizeChanged="DimensionsGrid_SizeChanged">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <NumberBox x:Name="WidthBox" Header="Width (px)" Minimum="480" Maximum="1600" ValueChanged="Draft_NumberChanged" />
                                    <NumberBox x:Name="HeightBox" Grid.Column="1" Header="Height (px)" Minimum="240" Maximum="1000" ValueChanged="Draft_NumberChanged" />
                                    <NumberBox x:Name="GapBox" Grid.Column="2" Header="Pointer gap (px)" Minimum="0" Maximum="64" ValueChanged="Draft_NumberChanged" />
                                </Grid>
                                <TextBlock Text="Scales with Windows display settings." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="PlacementPanel" Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Window placement" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="PlacementSizeText" Grid.Column="1" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Height="200">
                                    <Grid x:Name="PlacementScene" SizeChanged="PlacementScene_SizeChanged" AutomationProperties.Name="Terminal window placement preview">
                                        <TextBlock Text="File Explorer" Margin="12,8" VerticalAlignment="Top" FontSize="12" />
                                        <Canvas x:Name="PlacementCanvas" Margin="0,30,0,0">
                                            <Border x:Name="MiniTerminal" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                                                <StackPanel Padding="8" Spacing="8"><TextBlock x:Name="MiniTerminalTitle" Text="Windows Terminal" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="PS C:\Projects&gt;" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" /></StackPanel>
                                            </Border>
                                            <FontIcon x:Name="MiniPointer" Glyph="&#xE8B0;" FontSize="18" />
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Stays inside the current screen." FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button Content="Try another click point" HorizontalAlignment="Stretch" Click="Placement_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel>
                        <Grid Padding="24,20" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="45" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBadgeStyle}"><FontIcon Glyph="&#xE7B8;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /></Border>
                            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Extract archive" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock Text="ZIP, 7z, RAR, TAR, TAR.GZ and TGZ" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                            <ToggleSwitch x:Name="ArchiveEnabledToggle" Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="Enable archive shortcut" Toggled="Draft_Toggled" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel Padding="24" Spacing="18">
                            <Grid x:Name="ArchiveFieldsGrid" ColumnSpacing="20" RowSpacing="18" SizeChanged="ArchiveFieldsGrid_SizeChanged">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <ComboBox x:Name="ArchiveKeyCombo" Header="Shortcut" HorizontalAlignment="Stretch" SelectionChanged="Draft_SelectionChanged">
                                    <ComboBoxItem Content="Alt + left click" Tag="alt-left" /><ComboBoxItem Content="Ctrl + Alt + left click" Tag="ctrl-alt-left" /><ComboBoxItem Content="Alt + middle click" Tag="alt-middle" /><ComboBoxItem Content="Ctrl + Alt + middle click" Tag="ctrl-alt-middle" /><ComboBoxItem Content="Ctrl + left click" Tag="ctrl-left" />
                                </ComboBox>
                                <ComboBox x:Name="DestinationCombo" Grid.Column="1" Header="Extract to" HorizontalAlignment="Stretch" SelectionChanged="Draft_SelectionChanged"><ComboBoxItem Content="A new folder beside the archive" Tag="beside" /><ComboBoxItem Content="A folder I choose" Tag="custom" /></ComboBox>
                            </Grid>
                            <StackPanel x:Name="CustomFolderPanel" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="Destination folder" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="FolderTextBox" PlaceholderText="Choose an existing folder" AutomationProperties.Name="Destination folder" TextChanged="Draft_TextChanged" /><Button x:Name="BrowseButton" Grid.Column="1" Content="Browse" Click="Browse_Click" /></Grid>
                            </StackPanel>
                            <Border Padding="14" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}"><StackPanel Spacing="5"><TextBlock Text="Example · Toolkit.zip" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="OutputExampleText" TextWrapping="Wrap" /></StackPanel></Border>
                            <TextBlock Text="Keeps the source archive. Existing folders get a new name, such as Toolkit (1)." FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="FieldErrorsText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <StackPanel x:Name="ActivityPanel" Spacing="16" Visibility="Collapsed">
                <TextBlock Text="Recent actions" Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Text="This manager session · latest 50 completed actions" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="EmptyActivityText" Text="No actions yet. Use a shortcut in File Explorer or on the desktop." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="ActivityList" Spacing="10" />
            </StackPanel>
            <Grid x:Name="SaveBar" ColumnSpacing="16" RowSpacing="14" SizeChanged="SaveBar_SizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Spacing="4"><TextBlock x:Name="SaveStateText" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /><TextBlock Text="New settings apply when saved." FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                <StackPanel x:Name="SaveButtons" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Button x:Name="DiscardButton" Content="Discard" Click="Discard_Click" /><Button x:Name="SaveButton" Content="Save changes" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" /><ProgressRing x:Name="SaveProgress" Width="24" Height="24" IsActive="False" Visibility="Collapsed" /></StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
