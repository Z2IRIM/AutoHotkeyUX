<Page
    x:Class="AutoHotkeyUX.Modern.Pages.NewScriptPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1040"
            Padding="36,30,36,40"
            Spacing="22">

            <StackPanel Spacing="5">
                <TextBlock
                    Text="New Script"
                    FontSize="30"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="Create a clean AutoHotkey v2 script."
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="7">
                    <TextBlock Text="Script name" FontWeight="SemiBold" FontSize="13" />
                    <TextBox
                        x:Name="ScriptNameTextBox"
                        Text="ExplorerTools"
                        TextChanged="ScriptInput_Changed" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="7">
                    <TextBlock Text="Location" FontWeight="SemiBold" FontSize="13" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="ScriptLocationTextBox"
                            TextChanged="ScriptInput_Changed" />
                        <Button
                            Grid.Column="1"
                            Content="Browse"
                            Click="BrowseScriptLocationButton_Click" />
                    </Grid>
                </StackPanel>
            </Grid>

            <TextBlock
                Text="Template"
                FontWeight="SemiBold"
                FontSize="13" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="BlankTemplateButton"
                    Grid.Column="0"
                    Tag="Blank"
                    MinHeight="112"
                    Padding="16"
                    CornerRadius="9"
                    HorizontalContentAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    Click="TemplateButton_Click">
                    <StackPanel Spacing="7">
                        <FontIcon Glyph="&#xE8A5;" FontSize="20" HorizontalAlignment="Left" />
                        <TextBlock Text="Blank" FontWeight="SemiBold" />
                        <TextBlock
                            Text="Clean AutoHotkey v2 file."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="HotkeysTemplateButton"
                    Grid.Column="1"
                    Tag="Hotkeys"
                    MinHeight="112"
                    Padding="16"
                    CornerRadius="9"
                    HorizontalContentAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Click="TemplateButton_Click">
                    <StackPanel Spacing="7">
                        <FontIcon Glyph="&#xE765;" FontSize="20" HorizontalAlignment="Left" />
                        <TextBlock Text="Hotkeys" FontWeight="SemiBold" />
                        <TextBlock
                            Text="Keyboard shortcut starter."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="AutomationTemplateButton"
                    Grid.Column="2"
                    Tag="Automation"
                    MinHeight="112"
                    Padding="16"
                    CornerRadius="9"
                    HorizontalContentAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Click="TemplateButton_Click">
                    <StackPanel Spacing="7">
                        <FontIcon Glyph="&#xE945;" FontSize="20" HorizontalAlignment="Left" />
                        <TextBlock Text="Automation" FontWeight="SemiBold" />
                        <TextBlock
                            Text="Desktop automation starter."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border
                Padding="16"
                CornerRadius="9"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="Preview" FontWeight="SemiBold" FontSize="13" />
                    <TextBox
                        x:Name="ScriptPreviewTextBox"
                        MinHeight="120"
                        AcceptsReturn="True"
                        IsReadOnly="True"
                        FontFamily="Consolas"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </Border>

            <Grid>
                <TextBlock
                    x:Name="CreateScriptStatusText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button
                    HorizontalAlignment="Right"
                    Content="Create script"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="CreateScriptButton_Click" />
            </Grid>

            <InfoBar
                x:Name="CreateInfoBar"
                IsOpen="False"
                IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
