<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AutoHotkeyUX.Modern</RootNamespace>
    <AssemblyName>AutoHotkeyUX.Modern</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AutoHotkey.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Keep previous releases and source backups out of self-extracting publish inputs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**;backups\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="SharpCompress" Version="0.50.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\VisualFlow\v2\*.ahk" LogicalName="AutoHotkeyUX.Modern.VisualFlow.V2.%(Filename).ahk" />
    <EmbeddedResource Include="Resources\VisualFlow.Runtime.ahk" LogicalName="AutoHotkeyUX.Modern.VisualFlow.Runtime.ahk" />
    <None Remove="ToolPayload\**" />
    <Content Remove="ToolPayload\**" />
    <EmbeddedResource Include="ToolPayload\Ahk2Exe.zip" LogicalName="AutoHotkeyUX.Modern.Tools.Ahk2Exe.zip" />
    <EmbeddedResource Include="Resources\DocumentationTheme.css" LogicalName="AutoHotkeyUX.Modern.DocumentationTheme.css" />
    <!-- The icon is compiled/embedded; its editable artwork is a development asset. -->
    <None Remove="Assets\AutoHotkey.ico;Assets\AutoHotkey.svg;Assets\AutoHotkey.png" />
    <Content Remove="Assets\AutoHotkey.ico;Assets\AutoHotkey.svg;Assets\AutoHotkey.png" />
    <EmbeddedResource Include="Assets\AutoHotkey.ico"
                      LogicalName="AutoHotkeyUX.Modern.AppIcon.ico" />
    <EmbeddedResource Include="Resources\ExplorerShortcuts.ahk"
                      LogicalName="AutoHotkeyUX.Modern.ExplorerShortcuts.ahk" />
    <EmbeddedResource Include="Resources\ExplorerShortcuts\v3\Shell.ahk"
                      LogicalName="AutoHotkeyUX.Modern.ExplorerShortcuts.Shell.ahk" />
    <EmbeddedResource Include="Resources\ExplorerShortcuts\v3\Actions.ahk"
                      LogicalName="AutoHotkeyUX.Modern.ExplorerShortcuts.Actions.ahk" />
    <EmbeddedResource Include="Resources\ExplorerShortcuts\v3\Preferences.ahk"
                      LogicalName="AutoHotkeyUX.Modern.ExplorerShortcuts.Preferences.ahk" />
    <EmbeddedResource Include="RuntimePayload\AutoHotkey.runtime.zip"
                      LogicalName="AutoHotkeyUX.Modern.Runtime.AutoHotkey.zip" />
    <EmbeddedResource Include="RuntimePayload\AutoHotkeyUX.scripts.zip"
                      LogicalName="AutoHotkeyUX.Modern.Runtime.UX.zip" />
    <EmbeddedResource Include="RuntimePayload\runtime-manifest.json"
                      LogicalName="AutoHotkeyUX.Modern.Runtime.Manifest.json" />
  </ItemGroup>

  <Target Name="PrepareEmbeddedAutoHotkeyRuntime"
          BeforeTargets="PrepareResources">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\prepare-embedded-runtime.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>

  <Target Name="PrepareEmbeddedCompiler" BeforeTargets="PrepareResources">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\prepare-embedded-tools.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>

</Project>
