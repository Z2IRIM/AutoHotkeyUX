<Page
    x:Class="AutoHotkeyUX.Modern.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1040"
            Padding="36,30,36,40"
            Spacing="24"
            HorizontalAlignment="Stretch">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="5">
                    <TextBlock
                        Text="Good evening"
                        FontSize="30"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="Create scripts, inspect windows and manage how AutoHotkey runs."
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Padding="12,7"
                    CornerRadius="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon
                            x:Name="RuntimeStatusIcon"
                            Glyph="&#xE73E;"
                            FontSize="12" />
                        <TextBlock
                            x:Name="RuntimeStatusText"
                            Text="Detecting runtime…"
                            FontSize="12"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Button
                x:Name="NewScriptButton"
                HorizontalContentAlignment="Stretch"
                Padding="20"
                CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="NewScriptButton_Click">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="42"
                        Height="42"
                        CornerRadius="9"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}">
                        <FontIcon
                            Glyph="&#xE710;"
                            FontSize="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        Spacing="4"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="Create a new script"
                            FontSize="15"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="Start blank or choose a reusable template."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <FontIcon
                        Grid.Column="2"
                        Glyph="&#xE76C;"
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Grid>
                <TextBlock
                    Text="Tools"
                    FontSize="16"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="Quick actions"
                    HorizontalAlignment="Right"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    MinHeight="142"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Padding="18"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Click="WindowSpyButton_Click">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE890;" FontSize="22" HorizontalAlignment="Left" />
                        <TextBlock Text="Window Spy" FontWeight="SemiBold" />
                        <TextBlock
                            Text="Inspect windows, controls and coordinates."
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="1"
                    MinHeight="142"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Padding="18"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Click="CompileButton_Click">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE943;" FontSize="22" HorizontalAlignment="Left" />
                        <TextBlock Text="Compile" FontWeight="SemiBold" />
                        <TextBlock
                            Text="Convert a script into an executable."
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="2"
                    MinHeight="142"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Padding="18"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Click="DocumentationButton_Click">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE897;" FontSize="22" HorizontalAlignment="Left" />
                        <TextBlock Text="Documentation" FontWeight="SemiBold" />
                        <TextBlock
                            Text="Open AutoHotkey v2 help and reference."
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border
                Padding="18,16"
                CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="Runtime"
                            FontSize="13"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="RuntimeDetailsText"
                            Text="Detecting AutoHotkey…"
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Content="Manage"
                        VerticalAlignment="Center"
                        Click="ManageRuntimeButton_Click" />
                </Grid>
            </Border>

            <InfoBar
                x:Name="ActionInfoBar"
                IsOpen="False"
                IsClosable="True"
                Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
