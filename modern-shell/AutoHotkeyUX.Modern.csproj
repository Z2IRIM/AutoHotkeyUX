<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AutoHotkeyUX.Modern</RootNamespace>
    <AssemblyName>AutoHotkeyUX.Modern</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="SharpCompress" Version="0.50.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\ExplorerShortcuts.ahk"
                      LogicalName="AutoHotkeyUX.Modern.ExplorerShortcuts.ahk" />
    <EmbeddedResource Include="RuntimePayload\AutoHotkey.runtime.zip"
                      LogicalName="AutoHotkeyUX.Modern.Runtime.AutoHotkey.zip" />
    <EmbeddedResource Include="RuntimePayload\AutoHotkeyUX.scripts.zip"
                      LogicalName="AutoHotkeyUX.Modern.Runtime.UX.zip" />
    <EmbeddedResource Include="RuntimePayload\runtime-manifest.json"
                      LogicalName="AutoHotkeyUX.Modern.Runtime.Manifest.json" />
  </ItemGroup>

  <Target Name="PrepareEmbeddedAutoHotkeyRuntime"
          BeforeTargets="PrepareResources">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\prepare-embedded-runtime.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>

</Project>
