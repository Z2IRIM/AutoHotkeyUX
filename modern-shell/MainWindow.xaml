<Window x:Class="AutoHotkeyUX.Modern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoHotkey"
        Width="980"
        Height="650"
        MinWidth="780"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="4,4,4,20">
                    <Border Width="38"
                            Height="38"
                            Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="10">
                        <TextBlock Text="H"
                                   FontWeight="SemiBold"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,1,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AutoHotkey" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Modern UX" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button x:Name="HomeNavButton"
                            Content="⌂   Home"
                            HorizontalContentAlignment="Left"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Background="{StaticResource AccentSoftBrush}"
                            Click="HomeNavButton_Click"
                            Margin="0,0,0,6" />
                    <Button x:Name="NewScriptNavButton"
                            Content="＋   New Script"
                            HorizontalContentAlignment="Left"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="NewScriptNavButton_Click"
                            Margin="0,0,0,6" />
                    <Button x:Name="SettingsNavButton"
                            Content="⚙   Settings"
                            HorizontalContentAlignment="Left"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SettingsNavButton_Click" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="4,0,0,4">
                    <TextBlock x:Name="SidebarVersionText"
                               Text="AutoHotkey"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="Modern shell"
                               FontSize="11"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="34,30">
            <Grid x:Name="HomePage">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Good evening"
                                           FontSize="28"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Create scripts, inspect windows and manage how AutoHotkey runs."
                                           Margin="0,5,0,0"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Padding="10,5"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    CornerRadius="16">
                                <TextBlock x:Name="RuntimeStatusText"
                                           Text="● AutoHotkey ready"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </Border>
                        </Grid>

                        <Button Margin="0,26,0,0"
                                HorizontalContentAlignment="Stretch"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Padding="20"
                                Cursor="Hand"
                                Click="CreateScriptHero_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40"
                                        Height="40"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="10">
                                    <TextBlock Text="＋"
                                               FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Create a new script" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="Start blank or choose a reusable template."
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="›"
                                           FontSize="24"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
                        </Button>

                        <Grid Margin="0,26,0,10">
                            <TextBlock Text="Tools" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Quick actions"
                                       HorizontalAlignment="Right"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalContentAlignment="Left"
                                    Padding="16"
                                    Click="WindowSpyButton_Click">
                                <StackPanel>
                                    <TextBlock Text="◎" FontSize="22" />
                                    <TextBlock Text="Window Spy" Margin="0,10,0,0" FontWeight="SemiBold" />
                                    <TextBlock Text="Inspect windows, controls and coordinates."
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalContentAlignment="Left"
                                    Padding="16"
                                    Click="CompileButton_Click">
                                <StackPanel>
                                    <TextBlock Text="◇" FontSize="22" />
                                    <TextBlock Text="Compile" Margin="0,10,0,0" FontWeight="SemiBold" />
                                    <TextBlock Text="Convert a script into an executable."
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="4"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalContentAlignment="Left"
                                    Padding="16"
                                    Click="DocumentationButton_Click">
                                <StackPanel>
                                    <TextBlock Text="?" FontSize="22" />
                                    <TextBlock Text="Documentation" Margin="0,10,0,0" FontWeight="SemiBold" />
                                    <TextBlock Text="Open AutoHotkey v2 help and reference."
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Margin="0,24,0,0"
                                Padding="16"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Runtime" FontWeight="SemiBold" />
                                    <TextBlock x:Name="RuntimeDetailsText"
                                               Text="AutoHotkey runtime"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Content="Manage"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="ManageRuntimeButton_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="NewScriptPage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="New Script" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Create an AutoHotkey v2 script."
                                   Margin="0,5,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}" />

                        <Grid Margin="0,26,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Script name" FontSize="12" FontWeight="SemiBold" />
                                <TextBox x:Name="ScriptNameTextBox"
                                         Margin="0,8,0,0"
                                         Text="ExplorerTools"
                                         Style="{StaticResource RoundedTextBoxStyle}"
                                         TextChanged="ScriptInput_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Location" FontSize="12" FontWeight="SemiBold" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ScriptLocationTextBox"
                                             Style="{StaticResource RoundedTextBoxStyle}"
                                             TextChanged="ScriptInput_Changed" />
                                    <Button Grid.Column="2"
                                            Content="Browse"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BrowseScriptLocationButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Template"
                                   Margin="0,24,0,9"
                                   FontSize="12"
                                   FontWeight="SemiBold" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BlankTemplateButton"
                                    Grid.Column="0"
                                    Tag="Blank"
                                    HorizontalContentAlignment="Left"
                                    Background="{StaticResource AccentSoftBrush}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="14"
                                    Click="TemplateButton_Click">
                                <StackPanel>
                                    <TextBlock Text="□" FontSize="20" />
                                    <TextBlock Text="Blank" Margin="0,8,0,0" FontWeight="SemiBold" />
                                    <TextBlock Text="Clean AutoHotkey v2 file."
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="HotkeysTemplateButton"
                                    Grid.Column="2"
                                    Tag="Hotkeys"
                                    HorizontalContentAlignment="Left"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="14"
                                    Click="TemplateButton_Click">
                                <StackPanel>
                                    <TextBlock Text="⌨" FontSize="20" />
                                    <TextBlock Text="Hotkeys" Margin="0,8,0,0" FontWeight="SemiBold" />
                                    <TextBlock Text="Keyboard shortcut starter."
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="AutomationTemplateButton"
                                    Grid.Column="4"
                                    Tag="Automation"
                                    HorizontalContentAlignment="Left"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="14"
                                    Click="TemplateButton_Click">
                                <StackPanel>
                                    <TextBlock Text="⚡" FontSize="20" />
                                    <TextBlock Text="Automation" Margin="0,8,0,0" FontWeight="SemiBold" />
                                    <TextBlock Text="Desktop automation starter."
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Margin="0,22,0,0"
                                Padding="16"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="Preview" FontSize="12" FontWeight="SemiBold" />
                                <TextBox x:Name="ScriptPreviewTextBox"
                                         Margin="0,10,0,0"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="12"
                                         Foreground="{StaticResource MutedTextBrush}"
                                         MinHeight="100" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,20,0,0">
                            <TextBlock x:Name="CreateScriptStatusText"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="CancelCreateButton_Click" />
                                <Button Content="Create script"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="CreateScriptButton_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="SettingsPage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Common launcher and editor settings."
                                   Margin="0,5,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}" />

                        <Border Margin="0,26,0,0"
                                Padding="18"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Auto-detect script version" FontWeight="SemiBold" />
                                        <TextBlock Text="Use the existing AutoHotkey launcher to choose the interpreter."
                                                   Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <CheckBox x:Name="UseLauncherCheckBox"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Checked="UseLauncherCheckBox_Changed"
                                              Unchecked="UseLauncherCheckBox_Changed" />
                                </Grid>

                                <Separator Background="{StaticResource BorderBrush}" />

                                <Grid Margin="0,16,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Default v2 interpreter" FontWeight="SemiBold" />
                                        <TextBlock Text="Preferred build used by the launcher."
                                                   Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="InterpreterComboBox"
                                              Grid.Column="1"
                                              Padding="8,6"
                                              SelectionChanged="InterpreterComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Latest 2.x" />
                                        <ComboBoxItem Content="64-bit" />
                                        <ComboBoxItem Content="32-bit" />
                                    </ComboBox>
                                </Grid>

                                <Separator Background="{StaticResource BorderBrush}" />

                                <Grid Margin="0,16,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Script editor" FontWeight="SemiBold" />
                                        <TextBlock Text="Command used by the Edit Script shell action."
                                                   Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBox x:Name="EditorCommandTextBox"
                                                 Style="{StaticResource RoundedTextBoxStyle}" />
                                        <Button Content="Save editor command"
                                                Margin="0,8,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="SaveEditorButton_Click" />
                                    </StackPanel>
                                </Grid>

                                <Separator Background="{StaticResource BorderBrush}" />

                                <Grid Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Check for updates" FontWeight="SemiBold" />
                                        <TextBlock Text="Keep the existing Dashboard update preference."
                                                   Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <CheckBox x:Name="CheckUpdatesCheckBox"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Checked="CheckUpdatesCheckBox_Changed"
                                              Unchecked="CheckUpdatesCheckBox_Changed" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="SettingsStatusText"
                                   Margin="0,14,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
