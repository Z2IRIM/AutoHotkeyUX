<Page x:Class="AutoHotkeyUX.Modern.Pages.DocumentationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="44,32,44,24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="12">
            <Button Content="←  Home / Tools" Click="Home_Click" />
            <TextBlock Text="Documentation" Style="{StaticResource PageTitleTextStyle}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="BackButton" Content="Back" Click="Back_Click" IsEnabled="False" />
                <Button x:Name="ForwardButton" Content="Forward" Click="Forward_Click" IsEnabled="False" />
                <Button x:Name="ContentsButton" Content="Contents" Click="Contents_Click" IsEnabled="False" />
                <Button Content="Retry" Click="Retry_Click" />
            </StackPanel>
            <TextBlock x:Name="DocumentStatusText" Text="Preparing offline manual…" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar x:Name="DocumentInfoBar" IsOpen="False" Severity="Error" />
            <InfoBar x:Name="ExternalInfoBar" IsOpen="False" Severity="Informational" Title="External reference">
                <InfoBar.ActionButton><Button Content="Open inside app" Click="External_Click" /></InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
        <Border Grid.Row="3" Style="{StaticResource SurfaceCardStyle}" Padding="2">
            <Grid>
                <Grid x:Name="BrowserHost" />
                <Border x:Name="LoadingOverlay" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Margin="20">
                        <ProgressRing x:Name="LoadingRing" IsActive="True" Width="32" Height="32" />
                        <TextBlock x:Name="LoadingText" Text="Loading offline manual…" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
