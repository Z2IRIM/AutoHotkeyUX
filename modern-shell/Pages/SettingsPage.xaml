<Page
    x:Class="AutoHotkeyUX.Modern.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1040"
            Padding="36,30,36,40"
            Spacing="22">

            <StackPanel Spacing="5">
                <TextBlock
                    Text="Settings"
                    FontSize="30"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="AutoHotkey launcher, runtime and editor preferences."
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border
                Padding="18"
                CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="5">
                    <TextBlock Text="Detected runtime" FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="RuntimePathText"
                        Text="Detecting…"
                        TextWrapping="Wrap"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border
                CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel>
                    <Grid Padding="18,16" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Auto-detect script version" FontWeight="SemiBold" />
                            <TextBlock
                                Text="Use the AutoHotkey launcher to select the correct interpreter."
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="UseLauncherToggle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Toggled="UseLauncherToggle_Toggled" />
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid Padding="18,16" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Default v2 interpreter" FontWeight="SemiBold" />
                            <TextBlock
                                Text="Preferred architecture when multiple v2 runtimes are installed."
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox
                            x:Name="InterpreterComboBox"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="InterpreterComboBox_SelectionChanged">
                            <ComboBoxItem Content="Latest 2.x" />
                            <ComboBoxItem Content="64-bit" />
                            <ComboBoxItem Content="32-bit" />
                        </ComboBox>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid Padding="18,16" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Script editor" FontWeight="SemiBold" />
                            <TextBlock
                                Text="Command used by the Edit Script shell action."
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Grid Grid.Column="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="EditorCommandTextBox" />
                            <Button
                                Grid.Column="1"
                                Content="Save"
                                Click="SaveEditorButton_Click" />
                        </Grid>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid Padding="18,16" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Check for updates" FontWeight="SemiBold" />
                            <TextBlock
                                Text="Keep the existing AutoHotkey Dashboard update preference."
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="CheckUpdatesToggle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Toggled="CheckUpdatesToggle_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <InfoBar
                x:Name="SettingsInfoBar"
                IsOpen="False"
                IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
