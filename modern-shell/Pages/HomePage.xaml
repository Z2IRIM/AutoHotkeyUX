<Page
    x:Class="AutoHotkeyUX.Modern.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1080"
            Padding="40,34,40,48"
            Spacing="28"
            HorizontalAlignment="Stretch">

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="7">
                    <TextBlock
                        Text="AUTOMATION WORKSPACE"
                        Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock
                        Text="Welcome back"
                        Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock
                        Text="Create scripts, inspect windows, compile utilities and keep your AutoHotkey runtime in one place."
                        Style="{StaticResource PageSubtitleTextStyle}"
                        MaxWidth="700" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Padding="13,8"
                    CornerRadius="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            x:Name="RuntimeStatusIcon"
                            Glyph="&#xE73E;"
                            FontSize="12"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="RuntimeStatusText"
                            Text="Detecting runtime…"
                            FontSize="12"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Button
                x:Name="NewScriptButton"
                Style="{StaticResource InteractiveCardButtonStyle}"
                Padding="22"
                MinHeight="152"
                Click="NewScriptButton_Click">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="54"
                        Height="54"
                        CornerRadius="14"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        VerticalAlignment="Center">
                        <FontIcon
                            Glyph="&#xE943;"
                            FontSize="24"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="Create a new script"
                            FontSize="19"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="Start with a blank file or choose a focused starter template."
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Text="AutoHotkey v2"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Text="•"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock
                                Text="UTF-8"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Text="•"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock
                                Text="Never overwrites existing files"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Border
                        Grid.Column="2"
                        Width="36"
                        Height="36"
                        CornerRadius="18"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        VerticalAlignment="Center">
                        <FontIcon
                            Glyph="&#xE76C;"
                            FontSize="15"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <StackPanel Spacing="14">
                <Grid>
                    <StackPanel Spacing="3">
                        <TextBlock
                            Text="Tools"
                            Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Text="Quick access to the utilities used most often."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        MinHeight="154"
                        Style="{StaticResource InteractiveCardButtonStyle}"
                        Click="WindowSpyButton_Click">
                        <StackPanel Spacing="12">
                            <Border Style="{StaticResource IconBadgeStyle}">
                                <FontIcon
                                    Glyph="&#xE890;"
                                    FontSize="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="Window Spy"
                                    FontWeight="SemiBold"
                                    FontSize="14" />
                                <TextBlock
                                    Text="Inspect windows, controls, coordinates and process details."
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Column="1"
                        MinHeight="154"
                        Style="{StaticResource InteractiveCardButtonStyle}"
                        Click="CompileButton_Click">
                        <StackPanel Spacing="12">
                            <Border Style="{StaticResource IconBadgeStyle}">
                                <FontIcon
                                    Glyph="&#xE943;"
                                    FontSize="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="Compile"
                                    FontWeight="SemiBold"
                                    FontSize="14" />
                                <TextBlock
                                    Text="Turn an AutoHotkey script into a standalone executable."
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Column="2"
                        MinHeight="154"
                        Style="{StaticResource InteractiveCardButtonStyle}"
                        Click="DocumentationButton_Click">
                        <StackPanel Spacing="12">
                            <Border Style="{StaticResource IconBadgeStyle}">
                                <FontIcon
                                    Glyph="&#xE897;"
                                    FontSize="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="Documentation"
                                    FontWeight="SemiBold"
                                    FontSize="14" />
                                <TextBlock
                                    Text="Open the local AutoHotkey v2 help and language reference."
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="14">
                <TextBlock
                    Text="Runtime"
                    Style="{StaticResource SectionTitleTextStyle}" />

                <Border
                    Style="{StaticResource SurfaceCardStyle}"
                    Padding="18">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="42"
                            Height="42"
                            CornerRadius="21"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <FontIcon
                                Glyph="&#xE7F8;"
                                FontSize="17"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="4"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="Built-in AutoHotkey runtime"
                                FontSize="13"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="RuntimeDetailsText"
                                Text="Detecting AutoHotkey…"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Button
                            x:Name="ManageRuntimeButton"
                            Grid.Column="2"
                            Content="Manage"
                            VerticalAlignment="Center"
                            Click="ManageRuntimeButton_Click" />
                    </Grid>
                </Border>
            </StackPanel>

            <InfoBar
                x:Name="ActionInfoBar"
                IsOpen="False"
                IsClosable="True"
                Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
