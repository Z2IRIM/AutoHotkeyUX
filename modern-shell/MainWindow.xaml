<Window
    x:Class="AutoHotkeyUX.Modern.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="RootLayout"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The title bar is part of the app surface so Mica and navigation feel continuous. -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Orientation="Horizontal"
                Spacing="9"
                Margin="14,0,0,0"
                VerticalAlignment="Center">
                <Border
                    Width="26"
                    Height="26"
                    CornerRadius="7"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock
                        Text="H"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <TextBlock
                    Text="AutoHotkey"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </StackPanel>

            <AutoSuggestBox
                x:Name="GlobalSearchBox"
                Grid.Column="1"
                Width="340"
                Height="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                PlaceholderText="Search scripts, tools and settings"
                QueryIcon="Find"
                QuerySubmitted="GlobalSearchBox_QuerySubmitted" />
        </Grid>

        <!-- Lightweight custom sidebar matching the approved Gallery preview. -->
        <Grid
            Grid.Row="1"
            Grid.Column="0"
            Padding="10,14,10,12"
            Background="{ThemeResource LayerFillColorAltBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Margin="6,0,6,16"
                ColumnSpacing="11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="38"
                    Height="38"
                    CornerRadius="10"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock
                        Text="H"
                        Foreground="White"
                        FontSize="17"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    Spacing="1"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="AutoHotkey"
                        FontSize="14"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="Modern workspace"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <StackPanel
                Grid.Row="1"
                Spacing="2">
                <ToggleButton
                    x:Name="HomeNavButton"
                    Content="Home"
                    Tag="&#xE80F;"
                    Style="{StaticResource SidebarNavButtonStyle}"
                    Click="SidebarNavButton_Click" />
                <ToggleButton
                    x:Name="NewScriptNavButton"
                    Content="New Script"
                    Tag="&#xE710;"
                    Style="{StaticResource SidebarNavButtonStyle}"
                    Click="SidebarNavButton_Click" />
                <ToggleButton
                    x:Name="SettingsNavButton"
                    Content="Settings"
                    Tag="&#xE713;"
                    Style="{StaticResource SidebarNavButtonStyle}"
                    Click="SidebarNavButton_Click" />
            </StackPanel>

            <Border
                Grid.Row="3"
                Margin="4,12,4,0"
                Padding="12,10"
                CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="3">
                    <TextBlock
                        Text="AutoHotkey v2.0.29"
                        FontSize="11"
                        FontWeight="SemiBold" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6">
                        <Ellipse
                            Width="7"
                            Height="7"
                            Fill="#34C36D"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="Built-in runtime"
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border
            Grid.Row="1"
            Grid.Column="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <ContentPresenter x:Name="PageHost" />
        </Border>
    </Grid>
</Window>
