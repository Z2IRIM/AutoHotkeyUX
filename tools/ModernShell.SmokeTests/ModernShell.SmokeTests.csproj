<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\modern-shell\Resources\VisualFlow\v2\*.ahk" LogicalName="AutoHotkeyUX.Modern.VisualFlow.V2.%(Filename).ahk" />
    <EmbeddedResource Include="..\..\modern-shell\Resources\VisualFlow\v3\*.ahk" LogicalName="AutoHotkeyUX.Modern.VisualFlow.V3.%(Filename).ahk" />
    <EmbeddedResource Include="..\..\modern-shell\Resources\VisualFlow.Runtime.ahk" LogicalName="AutoHotkeyUX.Modern.VisualFlow.Runtime.ahk" />
    <PackageReference Include="SharpCompress" Version="0.50.3" />
    <Compile Include="..\..\modern-shell\Models\*.cs" Link="Models\%(Filename)%(Extension)" />
    <Compile Include="..\..\modern-shell\Services\Visual*.cs" Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\..\modern-shell\Services\ScriptFileName.cs" Link="Services\ScriptFileName.cs" />
    <Compile Include="..\..\modern-shell\Services\ScriptCatalogService.cs" Link="Services\ScriptCatalogService.cs" />
    <Compile Include="..\..\modern-shell\Services\ScriptExecutionService.cs" Link="Services\ScriptExecutionService.cs" />
    <Compile Include="..\..\modern-shell\Services\ScriptSessionStore.cs" Link="Services\ScriptSessionStore.cs" />
    <Compile Include="..\..\modern-shell\Services\ArchiveExtractionService.cs" Link="Services\ArchiveExtractionService.cs" />
    <Compile Include="..\..\modern-shell\Services\ShortcutPreferenceCodec.cs" Link="Services\ShortcutPreferenceCodec.cs" />
    <Compile Include="..\..\modern-shell\Services\ShortcutActivityService.cs" Link="Services\ShortcutActivityService.cs" />
    <Compile Include="..\..\modern-shell\Services\ShortcutPreferencesService.cs" Link="Services\ShortcutPreferencesService.cs" />
    <Compile Include="..\..\modern-shell\Services\ShortcutPreferencesRuntime.cs" Link="Services\ShortcutPreferencesRuntime.cs" />
    <Compile Include="..\..\modern-shell\Services\WindowInspectionNative.cs" Link="Services\WindowInspectionNative.cs" />
    <Compile Include="..\..\modern-shell\Services\ServiceDiagnostics.cs" Link="Services\ServiceDiagnostics.cs" />
    <Compile Include="..\..\modern-shell\Services\WindowsCommandLine.cs" Link="Services\WindowsCommandLine.cs" />
    <Compile Include="..\..\modern-shell\Services\AutoHotkeySettings.cs" Link="Services\AutoHotkeySettings.cs" />
    <Compile Include="..\..\modern-shell\Services\ScriptStartupService.cs" Link="Services\ScriptStartupService.cs" />
    <Compile Include="..\..\modern-shell\Services\ExplorerShortcutInstaller.cs" Link="Services\ExplorerShortcutInstaller.cs" />
    <Compile Include="..\..\modern-shell\Services\ShortcutCommandService.cs" Link="Services\ShortcutCommandService.cs" />
    <Compile Include="..\..\modern-shell\Services\ShortcutCommandService.Workflow.cs" Link="Services\ShortcutCommandService.Workflow.cs" />
    <EmbeddedResource Include="..\..\modern-shell\Resources\ExplorerShortcuts.ahk" LogicalName="AutoHotkeyUX.Modern.ExplorerShortcuts.ahk" />
    <EmbeddedResource Include="..\..\modern-shell\Resources\ExplorerShortcuts\v3\Shell.ahk" LogicalName="AutoHotkeyUX.Modern.ExplorerShortcuts.Shell.ahk" />
    <EmbeddedResource Include="..\..\modern-shell\Resources\ExplorerShortcuts\v3\Actions.ahk" LogicalName="AutoHotkeyUX.Modern.ExplorerShortcuts.Actions.ahk" />
    <EmbeddedResource Include="..\..\modern-shell\Resources\ExplorerShortcuts\v3\Preferences.ahk" LogicalName="AutoHotkeyUX.Modern.ExplorerShortcuts.Preferences.ahk" />
  </ItemGroup>
</Project>
