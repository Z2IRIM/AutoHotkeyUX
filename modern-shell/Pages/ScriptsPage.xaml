<Page
    x:Class="AutoHotkeyUX.Modern.Pages.ScriptsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="44,40,44,32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="9">
            <TextBlock Text="SCRIPTS" Style="{StaticResource EyebrowTextStyle}" />
            <TextBlock Text="Scripts" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Run, stop and organize your AutoHotkey scripts." Style="{StaticResource PageSubtitleTextStyle}" />
            <TextBlock x:Name="ScriptRootText" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Search script name" TextChanged="SearchBox_TextChanged"
                     AutomationProperties.Name="Search script name" />
            <Button Grid.Column="1" Content="Refresh" Click="RefreshButton_Click" />
            <Button Grid.Column="2" Content="Open folder" Click="OpenFolderButton_Click" />
        </Grid>
        <InfoBar x:Name="ActionInfoBar" Grid.Row="2" IsOpen="False" IsClosable="True" />
        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ScriptsList" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SurfaceCardStyle}" Padding="18" Margin="0,0,0,12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                                        <Border Grid.Column="1" CornerRadius="8" Padding="9,3" Background="{Binding StateBackground}">
                                            <TextBlock Text="{Binding StateText}" FontSize="13" Foreground="{Binding StateForeground}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Path}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding Path}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Details}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Error}" FontSize="13" TextWrapping="Wrap" Visibility="{Binding ErrorVisibility}"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <Grid x:Name="ScriptActionsGrid" ColumnSpacing="8" RowSpacing="8" Margin="0,6,0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup>
                                                <VisualState x:Name="ActionsCompact" />
                                                <VisualState x:Name="ActionsWide">
                                                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="760" /></VisualState.StateTriggers>
                                                    <VisualState.Setters>
                                                        <Setter Target="EditAction.(Grid.Row)" Value="0" /><Setter Target="EditAction.(Grid.Column)" Value="3" />
                                                        <Setter Target="FolderAction.(Grid.Row)" Value="0" /><Setter Target="FolderAction.(Grid.Column)" Value="4" />
                                                        <Setter Target="FolderAction.(Grid.ColumnSpan)" Value="1" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Button Content="Run" Grid.Column="0" Tag="{Binding Path}" IsEnabled="{Binding CanRun}" Click="RunButton_Click" FontSize="14" Padding="12,7" />
                                        <Button Content="Stop" Grid.Column="1" Tag="{Binding Path}" IsEnabled="{Binding CanStop}" Click="StopButton_Click" FontSize="14" Padding="12,7" />
                                        <Button Content="Restart" Grid.Column="2" Tag="{Binding Path}" IsEnabled="{Binding CanRestart}" Click="RestartButton_Click" FontSize="14" Padding="12,7" />
                                        <Button x:Name="EditAction" Content="Edit" Grid.Row="1" Grid.Column="0" Tag="{Binding Path}" IsEnabled="{Binding FileExists}" Click="EditButton_Click" FontSize="14" Padding="12,7" />
                                        <Button x:Name="FolderAction" Content="Open folder" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Tag="{Binding Path}" Click="RevealButton_Click" FontSize="14" Padding="12,7" />
                                    </Grid>
                                    <CheckBox Content="Run at sign-in" Tag="{Binding Path}" IsChecked="{Binding RunAtSignIn, Mode=OneWay}"
                                              IsEnabled="{Binding CanChangeStartup}" Click="StartupCheckBox_Click" FontSize="13"
                                              ToolTipService.ToolTip="{Binding StartupHint}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Visibility="Collapsed">
                <TextBlock x:Name="EmptyTitle" Text="No scripts yet" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyDescription" Text="Create a script in Documents\AutoHotkey to get started." FontSize="15"
                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
