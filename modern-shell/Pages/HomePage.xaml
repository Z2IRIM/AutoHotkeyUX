<Page
    x:Class="AutoHotkeyUX.Modern.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1040"
            Padding="38,34,38,48"
            Spacing="28"
            HorizontalAlignment="Stretch">

            <StackPanel Spacing="7">
                <TextBlock
                    Text="Welcome"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Text="Do more with AutoHotkey"
                    Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock
                    Text="Create scripts, inspect windows, compile utilities and keep your AutoHotkey runtime in one place."
                    Style="{StaticResource PageSubtitleTextStyle}"
                    MaxWidth="760" />
            </StackPanel>

            <Border
                Style="{StaticResource SurfaceCardStyle}"
                Padding="22">
                <Grid ColumnSpacing="17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="52"
                        Height="52"
                        CornerRadius="11"
                        Background="#217D91"
                        VerticalAlignment="Center">
                        <FontIcon
                            Glyph="&#xE943;"
                            FontSize="22"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        Spacing="5"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="Create a new script"
                            FontSize="17"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="Start with a blank file or choose a focused starter template."
                            FontSize="14"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="AutoHotkey v2  ·  UTF-8  ·  Never overwrites existing files"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <Button
                        x:Name="NewScriptButton"
                        Grid.Column="2"
                        Content="Create script"
                        MinHeight="42"
                        Padding="16,0"
                        Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center"
                        Click="NewScriptButton_Click" />
                </Grid>
            </Border>

            <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Tools"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        Text="Quick access to the utilities used most often."
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Grid x:Name="ToolGrid" ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="ToolCompact">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="WindowSpyButton.(Grid.Column)" Value="0" />
                                    <Setter Target="WindowSpyButton.(Grid.Row)" Value="0" />
                                    <Setter Target="CompileButton.(Grid.Column)" Value="1" />
                                    <Setter Target="CompileButton.(Grid.Row)" Value="0" />
                                    <Setter Target="DocumentationButton.(Grid.Column)" Value="0" />
                                    <Setter Target="DocumentationButton.(Grid.Row)" Value="1" />
                                    <Setter Target="DocumentationButton.(Grid.ColumnSpan)" Value="2" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="ToolWide">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="1240" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="WindowSpyButton.(Grid.Column)" Value="0" />
                                    <Setter Target="WindowSpyButton.(Grid.Row)" Value="0" />
                                    <Setter Target="CompileButton.(Grid.Column)" Value="1" />
                                    <Setter Target="CompileButton.(Grid.Row)" Value="0" />
                                    <Setter Target="DocumentationButton.(Grid.Column)" Value="2" />
                                    <Setter Target="DocumentationButton.(Grid.Row)" Value="0" />
                                    <Setter Target="DocumentationButton.(Grid.ColumnSpan)" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <Button
                        x:Name="WindowSpyButton"
                        Grid.Column="0"
                        Grid.Row="0"
                        MinHeight="160"
                        Style="{StaticResource InteractiveCardButtonStyle}"
                        Click="WindowSpyButton_Click">
                        <Grid>
                            <StackPanel Spacing="14">
                                <Border
                                    Width="42"
                                    Height="42"
                                    CornerRadius="10"
                                    Background="#7457E8"
                                    HorizontalAlignment="Left">
                                    <FontIcon
                                        Glyph="&#xE890;"
                                        FontSize="18"
                                        Foreground="White"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Text="Window Spy"
                                        FontWeight="SemiBold"
                                        FontSize="16" />
                                    <TextBlock
                                        Text="Inspect windows, controls, coordinates and process details."
                                        TextWrapping="Wrap"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <FontIcon
                                Glyph="&#xE76C;"
                                FontSize="14"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="CompileButton"
                        Grid.Column="1"
                        Grid.Row="0"
                        MinHeight="160"
                        Style="{StaticResource InteractiveCardButtonStyle}"
                        Click="CompileButton_Click">
                        <Grid>
                            <StackPanel Spacing="14">
                                <Border
                                    Width="42"
                                    Height="42"
                                    CornerRadius="10"
                                    Background="#418AF0"
                                    HorizontalAlignment="Left">
                                    <FontIcon
                                        Glyph="&#xE943;"
                                        FontSize="18"
                                        Foreground="White"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Text="Compile"
                                        FontWeight="SemiBold"
                                        FontSize="16" />
                                    <TextBlock
                                        Text="Turn an AutoHotkey script into a standalone executable."
                                        TextWrapping="Wrap"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <FontIcon
                                Glyph="&#xE76C;"
                                FontSize="14"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="DocumentationButton"
                        Grid.Column="2"
                        Grid.Row="0"
                        MinHeight="160"
                        Style="{StaticResource InteractiveCardButtonStyle}"
                        Click="DocumentationButton_Click">
                        <Grid>
                            <StackPanel Spacing="14">
                                <Border
                                    Width="42"
                                    Height="42"
                                    CornerRadius="10"
                                    Background="#63C998"
                                    HorizontalAlignment="Left">
                                    <FontIcon
                                        Glyph="&#xE897;"
                                        FontSize="18"
                                        Foreground="#073B2D"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Text="Documentation"
                                        FontWeight="SemiBold"
                                        FontSize="16" />
                                    <TextBlock
                                        Text="Open the local AutoHotkey v2 help and language reference."
                                        TextWrapping="Wrap"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <FontIcon
                                Glyph="&#xE76C;"
                                FontSize="14"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock
                    Text="Runtime"
                    Style="{StaticResource SectionTitleTextStyle}" />

                <Border
                    Style="{StaticResource SurfaceCardStyle}"
                    Padding="15">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="40"
                            Height="40"
                            CornerRadius="10"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <FontIcon
                                x:Name="RuntimeStatusIcon"
                                Glyph="&#xE7F8;"
                                FontSize="17"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="4"
                            VerticalAlignment="Center">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="9">
                                <TextBlock
                                    x:Name="RuntimeStatusText"
                                    Text="Detecting AutoHotkey…"
                                    FontSize="14"
                                    FontWeight="SemiBold" />
                                <Border
                                    x:Name="RuntimeReadyBadge"
                                    Padding="8,2"
                                    CornerRadius="10"
                                    Background="#2434C36D">
                                    <TextBlock
                                        Text="Ready"
                                        FontSize="11"
                                        Foreground="#34C36D" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                x:Name="RuntimeDetailsText"
                                Text="Preparing the built-in runtime…"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Button
                            x:Name="ManageRuntimeButton"
                            Grid.Column="2"
                            Content="Manage"
                            MinHeight="40"
                            Padding="15,0"
                            VerticalAlignment="Center"
                            Click="ManageRuntimeButton_Click" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <Grid>
                    <TextBlock
                        Text="Recent Scripts"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <Button
                        HorizontalAlignment="Right"
                        Content="Open folder"
                        MinHeight="38"
                        Padding="13,0"
                        FontSize="12"
                        Click="OpenScriptsFolderButton_Click" />
                </Grid>

                <Border Style="{StaticResource SurfaceCardStyle}">
                    <Grid>
                        <ItemsControl x:Name="RecentScriptsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="14,10"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon
                                            Glyph="&#xE8A5;"
                                            FontSize="14"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Name}"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding Path}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{Binding ModifiedText}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            x:Name="RecentScriptsEmptyText"
                            Text="No scripts found in Documents\AutoHotkey yet."
                            Padding="18,16"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>
            </StackPanel>

            <InfoBar
                x:Name="ActionInfoBar"
                IsOpen="False"
                IsClosable="True"
                Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
